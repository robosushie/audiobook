NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<YOUR_CLERK_PUBLISHABLE_KEY>
CLERK_SECRET_KEY=<YOUR_CLERK_SECRET_KEY>

# Optional: password for scripts/bootstrap when creating new Clerk users
# BOOTSTRAP_PASSWORD=<YOUR_BOOTSTRAP_PASSWORD>

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=<YOUR_CLERK_PUBLISHABLE_KEY>

# PostgreSQL — local dev
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=audiobook

# PostgreSQL — Supabase (session pooler; use db:upgrade, not db:create)
# DATABASE_USER=postgres.<project-ref>
# DATABASE_PASSWORD=<YOUR_DATABASE_PASSWORD>
# DATABASE_HOST=aws-0-<region>.pooler.supabase.com
# DATABASE_PORT=5432
# DATABASE_NAME=postgres

# Supabase Storage — use service role key for backend uploads
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# Bucket names (must exist in Supabase Storage)
VOICE_BUCKET=voice
AUDIOBOOK_BUCKET=audiobook

# Groq — Whisper STT for voice profile alignment
GROQ_API_KEY=<YOUR_GROQ_API_KEY>

# Inngest — background jobs (voice preprocess, audiobook generation)
#
# Inngest Cloud (production): unset INNGEST_DEV and set BOTH keys below.
#   Event key:   https://app.inngest.com → Manage → Event keys → Create
#   Signing key: https://app.inngest.com → Apps → your app → Signing key
# Deploy event service so Cloud can reach: https://<host>/api/inngest
#   pnpm run service:event  (local :8001)
#
INNGEST_EVENT_KEY=<YOUR_INNGEST_EVENT_KEY>
INNGEST_SIGNING_KEY=<YOUR_INNGEST_SIGNING_KEY>

# Local Inngest Dev Server only (not Inngest Cloud):
# INNGEST_DEV=1
