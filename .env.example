NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<YOUR_CLERK_PUBLISHABLE_KEY>
CLERK_SECRET_KEY=<YOUR_CLERK_SECRET_KEY>

# Optional: password for scripts/bootstrap when creating new Clerk users
# BOOTSTRAP_PASSWORD=<YOUR_BOOTSTRAP_PASSWORD>

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=<YOUR_CLERK_PUBLISHABLE_KEY>
# Mobile app API (device/emulator). Use LAN IP for local dev; HTTPS public URL for EAS APK builds.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.3:8000
# EXPO_PUBLIC_API_BASE_URL=https://your-api.example.com

# PostgreSQL — local Docker Compose (docker compose up -d)
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=audiobook

# Redis — local Docker Compose
REDIS_URL=redis://localhost:6379/0

# MinIO (S3). Host tools use localhost; Compose sets S3_ENDPOINT=http://minio:9000.
# Console: http://127.0.0.1:9001
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
VOICE_BUCKET=voice
AUDIOBOOK_BUCKET=audiobook
BOOK_BUCKET=book

# Cloner weights — temp/indicf5 (Hindi + Indic), temp/chatterbox (English), temp/habibi (Arabic Unified)
# CLONER_MODEL_DIR=temp
#
# IndicF5 on Hugging Face is gated — accept terms at https://huggingface.co/ai4bharat/IndicF5
# HF_TOKEN=<YOUR_HUGGING_FACE_TOKEN>
#
# Habibi Unified weights are CC-BY-NC-SA-4.0 (non-commercial). Optional dialect: UNK, MSA, EGY, ...
# HABIBI_DIALECT=UNK

# Voice alignment runs in the preprocess container. Cloning runs in the cloner container.
# PREPROCESS_BASE_URL=http://127.0.0.1:8003
# CLONER_BASE_URL=http://127.0.0.1:8002
# PREPROCESS_MODEL_DIR=temp/preprocess-models
# PREPROCESS_DEVICE=cpu
#
# MMS forced-aligner weights (MahmoudAshraf/mms-300m-1130-forced-aligner) are CC-BY-NC 4.0.
