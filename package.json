{
  "name": "audiobook",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "eas-build-pre-install": "npm install --global pnpm@10.12.1",
    "dev": "concurrently -n admin,api -c cyan,magenta --kill-others-on-fail \"pnpm run app:admin\" \"pnpm run service:api\"",
    "infra:up": "python scripts/run.py infra:up",
    "deploy:stack": "python scripts/run.py deploy:stack",
    "db:create": "python scripts/run.py db:create",
    "db:make": "python scripts/run.py db:make",
    "db:upgrade": "python scripts/run.py db:upgrade",
    "service:api": "python scripts/run.py service:api",
    "service:cloner": "python scripts/run.py service:cloner",
    "service:preprocess": "python scripts/run.py service:preprocess",
    "app:admin": "pnpm -C apps/admin run dev",
    "app:admin:build": "pnpm -C apps/admin run build",
    "bootstrap": "python scripts/bootstrap/run.py"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
