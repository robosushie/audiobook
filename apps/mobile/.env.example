# Local Expo / EAS CLI (app.config.ts reads this file). Not uploaded to EAS cloud.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.3:8000

# ---------------------------------------------------------------------------
# EAS builds (Android APK / AAB)
# ---------------------------------------------------------------------------
# EXPO_PUBLIC_* values are baked into the JS bundle at BUILD time.
# Your .env file is gitignored and is NOT sent to EAS cloud builders.
#
# From apps/mobile, create env vars for each build profile (preview = internal APK):
#
#   eas env:create --environment preview --name EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY --value pk_test_...
#   eas env:create --environment preview --name EXPO_PUBLIC_API_BASE_URL --value https://your-api.example.com
#
# Repeat for production if you use that profile. List with: eas env:list
#
# API URL rules for a physical device:
#   - Do NOT use http://localhost:8000 (refers to the phone itself)
#   - LAN IP (http://192.168.x.x:8000) works only on the same Wi‑Fi
#   - Prefer a public HTTPS URL (deployed API, ngrok, Tailscale Funnel, etc.)
#
# Clerk native (standalone APK, not Expo Go):
#   1. Clerk Dashboard → Configure → Native applications → Add Android
#   2. Package name: com.audiobook.mobile (matches app.config.ts)
#   3. Add SHA-256 cert fingerprint: eas credentials -p android
